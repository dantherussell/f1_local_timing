<h1>Post to Telegram</h1>
<h2><%= @weekend.gp_title %></h2>

<% if flash.now[:alert] %>
  <div class="alert alert-danger">
    <%= flash.now[:alert] %>
  </div>
<% end %>

<div data-controller="telegram-share"
     data-telegram-share-print-url-value="<%= print_season_weekend_path(@season, @weekend) %>">
  <iframe data-telegram-share-target="frame" style="width: 480px; height: 1px; border: 0;"></iframe>

  <p><img data-telegram-share-target="preview" alt="Schedule preview" style="max-width: 100%;"></p>

  <%= form_with url: telegram_season_weekend_path(@season, @weekend), method: :post, local: true,
                data: { telegram_share_target: "form", action: "submit->telegram-share#submit" } do |f| %>
    <div class="form-group">
      <%= f.label :preamble, "Preamble" %>
      <%= f.text_area :preamble, class: "form-control", rows: 3 %>
    </div>
    <div class="form-group">
      <%= f.submit "Send to Telegram", data: { telegram_share_target: "submitButton" }, disabled: true %>
    </div>
  <% end %>
</div>

<br>
<%= link_to "Back", season_weekend_path(@season, @weekend) %>
